{
  "name": "slopbot",
  "version": "0.1.0",
  "description": "Open-source personal AI agents that run on your own computer. Bring your own model or run fully local.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "slopbot": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "slopbot": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.desktop.json",
    "privacy:scan": "node scripts/privacy-scan.mjs",
    "test": "tsx --import ./test/setup.ts --test test/*.test.ts",
    "desktop:build": "node desktop/build.mjs",
    "desktop": "node desktop/build.mjs && electron .",
    "desktop:preview": "node desktop/build.mjs && npx --yes http-server dist-desktop/renderer -a 127.0.0.1 -p 5199 -c-1",
    "desktop:dist": "node desktop/build.mjs && node desktop/dist.mjs",
    "desktop:dist:mac": "node desktop/build.mjs && node desktop/dist.mjs --mac",
    "desktop:dist:win": "node desktop/build.mjs && electron-builder --win --x64 --publish never",
    "desktop:dist:linux": "node desktop/build.mjs && electron-builder --linux --x64 --publish never",
    "branding": "node assets/branding/generate.mjs",
    "desktop:dist:win:zip": "node desktop/build.mjs && electron-builder --win zip --x64 --publish never",
    "desktop:dist:mac:ci": "node desktop/build.mjs && node desktop/dist.mjs --mac --x64 --arm64",
    "desktop:dist:win:ci": "node desktop/build.mjs && electron-builder --win --x64 --publish never",
    "desktop:dist:linux:ci": "node desktop/build.mjs && electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "croner": "^10.0.1",
    "nodemailer": "^10.0.13",
    "three": "^0.186.1",
    "undici": "^7.30.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/three": "^0.186.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "main": "dist-desktop/main.cjs",
  "productName": "SlopBot",
  "author": {
    "name": "SlopBot contributors"
  },
  "build": {
    "appId": "dev.slopbot.app",
    "productName": "SlopBot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bots",
        "to": "seed/bots"
      },
      {
        "from": "examples",
        "to": "seed/examples"
      },
      {
        "from": "skills",
        "to": "seed/skills"
      },
      {
        "from": "slopbot.config.example.yaml",
        "to": "seed/slopbot.config.example.yaml"
      }
    ],
    "afterPack": "desktop/after-pack.cjs",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/branding/generated/icon.icns",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "SlopBot ${version}"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/branding/generated/icon.ico",
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/branding/generated/icon-512.png",
      "executableName": "slopbot",
      "synopsis": "Personal AI agents that run on your own computer",
      "maintainer": "SlopBot contributors",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-linux-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "${productName}-${version}-linux-amd64.${ext}"
    }
  },
  "homepage": "https://github.com/CameronWDavis/SlopBot",
  "repository": {
    "type": "git",
    "url": "https://github.com/CameronWDavis/SlopBot.git"
  },
  "bugs": {
    "url": "https://github.com/CameronWDavis/SlopBot/issues"
  }
}
